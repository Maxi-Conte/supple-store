# --- Base de datos ---
# Render/Railway te dan esta URL automáticamente al crear un Postgres.
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# --- Autenticación ---
JWT_SECRET=cambiar_esto_por_un_string_largo_y_random

# --- Mercado Pago ---
# Sacalas de https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- General ---
PORT=3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# --- Mercado Pago: firma del webhook ---
# Panel de MP > Tus integraciones > Webhooks > "Clave secreta"
MP_WEBHOOK_SECRET=

# --- Envíos ---
# Costo fijo del envío a domicilio (en pesos)
ENVIO_COSTO=6000
# Envío gratis a partir de este subtotal (0 = nunca)
ENVIO_GRATIS_DESDE=100000
# Si se completa, se ofrece "Retiro en local" con esta dirección
RETIRO_DIRECCION=

# --- Avisos de ventas ---
# A dónde llegan los mails de "nueva venta" (si se deja vacío, usa SMTP_USER)
MAIL_TIENDA=
